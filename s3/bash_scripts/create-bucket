#!/usr/bin/env bash

echo "== Creating Bucket=="

# Creck for bucket name
if [ -z "$1" ]; then
    echo "There needs to be a bucket name"
    exit 1
fi

BUCKET_NAME=$1

aws s3api create-bucket \
--bucket "$BUCKET_NAME" \
--create-bucket-configuration='LocationConstraint=eu-west-1' \
--query Location \
--output text